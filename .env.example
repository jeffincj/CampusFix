# Copy this file to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: "mysql" (default) or "sqlite" (quick local runs)
DB_ENGINE=mysql
DB_NAME=campusfix
DB_USER=campusfix
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
# Only used by the MySQL container in docker-compose
MYSQL_ROOT_PASSWORD=change-me-root

# JWT (REST API)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1
AUTH_THROTTLE_RATE=20/min

# Machine learning
ML_ARTIFACT_DIR=

# LLM (GenAI). LLM_PROVIDER=none turns the LLM off; the app then uses the classifier.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high  (low is enough for classification and keeps cost down)
LLM_EFFORT=low
# "default" = if the model declines a request, the API retries it on a fallback model. "off" to disable.
LLM_FALLBACKS=default
LLM_TIMEOUT_SECONDS=60
# USD per million tokens, used for the cost metric (claude-opus-5-5 prices; change with the model)
LLM_INPUT_COST_PER_MTOK=4.00
LLM_OUTPUT_COST_PER_MTOK=20.00

# Embeddings: "local" (default, offline) or "sentence-transformers" (pip install sentence-transformers)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
DUPLICATE_THRESHOLD=0.85
