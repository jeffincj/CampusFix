# Copy this file to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: "mysql" (default) or "sqlite" (quick local runs)
DB_ENGINE=mysql
DB_NAME=campusfix
DB_USER=campusfix
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
# Only used by the MySQL container in docker-compose
MYSQL_ROOT_PASSWORD=change-me-root

# JWT (REST API)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1
AUTH_THROTTLE_RATE=20/min

# Machine learning
ML_ARTIFACT_DIR=
