msgid "Email"
msgstr "ഇമെയിൽ"

msgid "First name"
msgstr "പേരിന്റെ ആദ്യഭാഗം"

msgid "Last name"
msgstr "കുടുംബപ്പേര്"

#| msgid "Use only letters, numbers and @ . + - _"
msgid "Letters, numbers and @ . + - _ only."
msgstr "അക്ഷരങ്ങൾ, അക്കങ്ങൾ, @ . + - _ എന്നിവ മാത്രം."

msgid "Password"
msgstr "പാസ്‌വേഡ്"

msgid ""
"At least 8 characters. Not too common, not only numbers, not similar to your"
" name."
msgstr ""
"കുറഞ്ഞത് 8 അക്ഷരങ്ങൾ. വളരെ സാധാരണമായതോ, അക്കങ്ങൾ മാത്രമുള്ളതോ, നിങ്ങളുടെ "
"പേരിനോട് സാമ്യമുള്ളതോ ആകരുത്."

#| msgid "Passwords do not match."
msgid "Password confirmation"
msgstr "പാസ്‌വേഡ് സ്ഥിരീകരണം"

msgid "Enter the same password again."
msgstr "അതേ പാസ്‌വേഡ് വീണ്ടും നൽകുക."

msgid "An account with this email already exists."
msgstr "ഈ ഇമെയിലിൽ ഇതിനകം ഒരു അക്കൗണ്ട് ഉണ്ട്."

msgid "Username"
msgstr "ഉപയോക്തൃനാമം"

msgid "Student"
msgstr "വിദ്യാർത്ഥി"

msgid "Staff"
msgstr "ജീവനക്കാരൻ"

msgid "Admin"
msgstr "അഡ്മിൻ"

msgid ""
"Please describe only the campus problem, without instructions to the system."
msgstr ""
"സിസ്റ്റത്തിനുള്ള നിർദ്ദേശങ്ങൾ ഇല്ലാതെ, ക്യാമ്പസ് പ്രശ്നം മാത്രം വിവരിക്കുക."

msgid ""
"Links are not allowed in complaints. Please describe the problem in words."
msgstr "പരാതികളിൽ ലിങ്കുകൾ അനുവദനീയമല്ല. പ്രശ്നം വാക്കുകളിൽ വിവരിക്കുക."

msgid ""
"Your complaint looks like spam (repeated characters). Please write it "
"normally."
msgstr ""
"നിങ്ങളുടെ പരാതി സ്പാം പോലെ തോന്നുന്നു (ആവർത്തിക്കുന്ന അക്ഷരങ്ങൾ). സാധാരണ "
"രീതിയിൽ എഴുതുക."

msgid ""
"Your complaint repeats the same word many times. Please write it normally."
msgstr ""
"നിങ്ങളുടെ പരാതിയിൽ ഒരേ വാക്ക് പലതവണ ആവർത്തിക്കുന്നു. സാധാരണ രീതിയിൽ എഴുതുക."

msgid "Your complaint has too few words. Please describe the problem."
msgstr "നിങ്ങളുടെ പരാതിയിൽ വാക്കുകൾ വളരെ കുറവാണ്. പ്രശ്നം വിവരിക്കുക."

msgid ""
"Please remove abusive language. You can still report the problem politely."
msgstr "അധിക്ഷേപകരമായ ഭാഷ ഒഴിവാക്കുക. പ്രശ്നം മാന്യമായി അറിയിക്കാം."

msgid ""
"This does not look like a campus problem. Please mention what is wrong and "
"where (hostel, mess, Wi-Fi, lab, bus, ...)."
msgstr ""
"ഇത് ഒരു ക്യാമ്പസ് പ്രശ്നമായി തോന്നുന്നില്ല. എന്താണ് പ്രശ്നം, എവിടെ എന്ന് "
"പറയുക (ഹോസ്റ്റൽ, മെസ്സ്, Wi-Fi, ലാബ്, ബസ്, ...)."

msgid ""
"You have sent many complaints in the last hour. Please wait a little before "
"sending more."
msgstr ""
"കഴിഞ്ഞ ഒരു മണിക്കൂറിൽ നിങ്ങൾ ധാരാളം പരാതികൾ അയച്ചു. കൂടുതൽ അയയ്ക്കുന്നതിന് "
"മുമ്പ് അൽപ്പം കാത്തിരിക്കുക."

#, python-format
msgid "You already reported this (complaint #%(id)s). You can track it there."
msgstr ""
"നിങ്ങൾ ഇത് ഇതിനകം റിപ്പോർട്ട് ചെയ്തിട്ടുണ്ട് (പരാതി #%(id)s). അവിടെ അതിന്റെ "
"നില കാണാം."

msgid "I can only answer questions about campus complaints and college rules."
msgstr ""
"ക്യാമ്പസ് പരാതികളെയും കോളേജ് നിയമങ്ങളെയും കുറിച്ചുള്ള ചോദ്യങ്ങൾക്ക് മാത്രമേ "
"എനിക്ക് മറുപടി നൽകാൻ കഴിയൂ."

msgid "Title"
msgstr "തലക്കെട്ട്"

msgid "Description"
msgstr "വിവരണം"

msgid "Category (optional, our AI decides)"
msgstr "വിഭാഗം (ഐച്ഛികം, ഞങ്ങളുടെ AI തീരുമാനിക്കും)"

msgid "Location"
msgstr "സ്ഥലം"

msgid "Block / building (optional)"
msgstr "ബ്ലോക്ക് / കെട്ടിടം (ഐച്ഛികം)"

msgid "Write in English, Tamil, Malayalam, or a mix."
msgstr "ഇംഗ്ലീഷ്, തമിഴ്, മലയാളം അല്ലെങ്കിൽ ഇടകലർത്തി എഴുതാം."

msgid "Example: Room 214, near the lift"
msgstr "ഉദാഹരണം: മുറി 214, ലിഫ്റ്റിന് സമീപം"

msgid "Not sure"
msgstr "ഉറപ്പില്ല"

msgid "Please describe the problem in at least 10 characters."
msgstr "പ്രശ്നം കുറഞ്ഞത് 10 അക്ഷരങ്ങളിൽ വിവരിക്കുക."

msgid "Optional note"
msgstr "കുറിപ്പ് (ഐച്ഛികം)"

msgid "Rating"
msgstr "റേറ്റിംഗ്"

msgid "Comment"
msgstr "അഭിപ്രായം"

msgid "Hostel"
msgstr "ഹോസ്റ്റൽ"

msgid "Mess & Food"
msgstr "മെസ്സ് & ഭക്ഷണം"

msgid "Wi-Fi & IT"
msgstr "Wi-Fi & IT"

msgid "Labs & Academics"
msgstr "ലാബുകൾ & അക്കാദമിക്"

msgid "Transport"
msgstr "ഗതാഗതം"

msgid "Electrical & Plumbing"
msgstr "ഇലക്ട്രിക്കൽ & പ്ലംബിംഗ്"

msgid "Cleanliness & Sanitation"
msgstr "ശുചിത്വം"

msgid "Safety & Security"
msgstr "സുരക്ഷ"

msgid "Low"
msgstr "കുറവ്"

msgid "Medium"
msgstr "ഇടത്തരം"

msgid "High"
msgstr "ഉയർന്നത്"

msgid "Critical"
msgstr "അതിഗുരുതരം"

msgid "Open"
msgstr "തുറന്നത്"

msgid "In progress"
msgstr "പുരോഗമിക്കുന്നു"

msgid "Resolved"
msgstr "പരിഹരിച്ചു"

msgid "Closed"
msgstr "അടച്ചു"

msgid "Rejected"
msgstr "നിരസിച്ചു"

msgid "English"
msgstr "ഇംഗ്ലീഷ്"

msgid "Tamil"
msgstr "തമിഴ്"

msgid "Malayalam"
msgstr "മലയാളം"

msgid "Mixed language"
msgstr "ഇടകലർന്ന ഭാഷ"

msgid "Other"
msgstr "മറ്റുള്ളവ"

msgid "AI language model"
msgstr "AI ഭാഷാ മോഡൽ"

msgid "AI classifier (machine learning)"
msgstr "AI ക്ലാസിഫയർ (മെഷീൻ ലേണിംഗ്)"

msgid "Your choice"
msgstr "നിങ്ങളുടെ തിരഞ്ഞെടുപ്പ്"

msgid "Sample data"
msgstr "സാമ്പിൾ ഡാറ്റ"

#, python-format
msgid "Complaint #%(id)s submitted. You can track it here."
msgstr "പരാതി #%(id)s സമർപ്പിച്ചു. അതിന്റെ നില ഇവിടെ കാണാം."

msgid ""
"Another student already reported this problem. We linked the two complaints "
"so it gets fixed faster."
msgstr ""
"മറ്റൊരു വിദ്യാർത്ഥി ഈ പ്രശ്നം ഇതിനകം റിപ്പോർട്ട് ചെയ്തിട്ടുണ്ട്. വേഗത്തിൽ "
"പരിഹരിക്കാൻ രണ്ട് പരാതികളും ബന്ധിപ്പിച്ചു."

msgid "Only open complaints can be edited."
msgstr "തുറന്ന പരാതികൾ മാത്രമേ തിരുത്താൻ കഴിയൂ."

msgid "Complaint updated."
msgstr "പരാതി പുതുക്കി."

msgid "Only open complaints can be deleted."
msgstr "തുറന്ന പരാതികൾ മാത്രമേ ഇല്ലാതാക്കാൻ കഴിയൂ."

msgid "Complaint deleted."
msgstr "പരാതി ഇല്ലാതാക്കി."

msgid "You cannot update this complaint."
msgstr "നിങ്ങൾക്ക് ഈ പരാതി പുതുക്കാൻ കഴിയില്ല."

#, python-format
msgid "Status changed to %(status)s."
msgstr "നില %(status)s ആയി മാറ്റി."

msgid "That status change is not allowed."
msgstr "ആ നില മാറ്റം അനുവദനീയമല്ല."

msgid "Feedback is not possible for this complaint."
msgstr "ഈ പരാതിക്ക് ഫീഡ്ബാക്ക് നൽകാൻ കഴിയില്ല."

msgid "Thank you for your feedback!"
msgstr "നിങ്ങളുടെ ഫീഡ്ബാക്കിന് നന്ദി!"

msgid "Please choose a rating from 1 to 5."
msgstr "1 മുതൽ 5 വരെ ഒരു റേറ്റിംഗ് തിരഞ്ഞെടുക്കുക."

msgid "Hostel Office"
msgstr "ഹോസ്റ്റൽ ഓഫീസ്"

msgid "Mess & Food Committee"
msgstr "മെസ്സ് & ഭക്ഷണ കമ്മിറ്റി"

msgid "IT Services"
msgstr "IT സേവനങ്ങൾ"

msgid "Transport Office"
msgstr "ഗതാഗത ഓഫീസ്"

msgid "Maintenance (Electrical & Plumbing)"
msgstr "മെയിന്റനൻസ് (ഇലക്ട്രിക്കൽ & പ്ലംബിംഗ്)"

msgid "Housekeeping & Sanitation"
msgstr "ഹൗസ്കീപ്പിംഗ് & ശുചിത്വം"

msgid "Security Office"
msgstr "സുരക്ഷാ ഓഫീസ്"

msgid "Complaint submitted"
msgstr "പരാതി സമർപ്പിച്ചു"

msgid "Changed in Django admin"
msgstr "Django അഡ്മിനിൽ മാറ്റി"

msgid "Synthetic sample data"
msgstr "കൃത്രിമ സാമ്പിൾ ഡാറ്റ"

msgid "Category"
msgstr "വിഭാഗം"

msgid "Status"
msgstr "നില"

msgid "Submitted"
msgstr "സമർപ്പിച്ചത്"

msgid "No complaints yet."
msgstr "ഇതുവരെ പരാതികളൊന്നുമില്ല."

msgid "Dashboard"
msgstr "ഡാഷ്ബോർഡ്"

msgid "Complaints"
msgstr "പരാതികൾ"

msgid "Logout"
msgstr "ലോഗൗട്ട്"

msgid "Login"
msgstr "ലോഗിൻ"

msgid "Register"
msgstr "രജിസ്റ്റർ ചെയ്യുക"

msgid "Language"
msgstr "ഭാഷ"

msgid "Change"
msgstr "മാറ്റുക"

msgid "CampusFix · AI complaint system for our campus"
msgstr "CampusFix · ഞങ്ങളുടെ ക്യാമ്പസിനായുള്ള AI പരാതി സംവിധാനം"

msgid "This field is required."
msgstr "ഈ ഫീൽഡ് ആവശ്യമാണ്."

msgid "Enter a valid email address."
msgstr "സാധുവായ ഇമെയിൽ വിലാസം നൽകുക."

msgid "Use only letters, numbers and @ . + - _"
msgstr "അക്ഷരങ്ങൾ, അക്കങ്ങൾ, @ . + - _ എന്നിവ മാത്രം ഉപയോഗിക്കുക"

msgid "Password must be at least 8 characters."
msgstr "പാസ്‌വേഡ് കുറഞ്ഞത് 8 അക്ഷരങ്ങൾ ആയിരിക്കണം."

msgid "Passwords do not match."
msgstr "പാസ്‌വേഡുകൾ പൊരുത്തപ്പെടുന്നില്ല."

msgid "Delete complaint"
msgstr "പരാതി ഇല്ലാതാക്കുക"

#, python-format
msgid "Delete complaint #%(id)s?"
msgstr "പരാതി #%(id)s ഇല്ലാതാക്കണോ?"

#, python-format
msgid "“%(title)s” will be removed. This cannot be undone."
msgstr "“%(title)s” നീക്കം ചെയ്യപ്പെടും. ഇത് തിരികെ കൊണ്ടുവരാൻ കഴിയില്ല."

msgid "Yes, delete"
msgstr "അതെ, ഇല്ലാതാക്കുക"

msgid "Cancel"
msgstr "റദ്ദാക്കുക"

#, python-format
msgid "Complaint #%(id)s"
msgstr "പരാതി #%(id)s"

msgid "Not set yet"
msgstr "ഇതുവരെ നിശ്ചയിച്ചിട്ടില്ല"

msgid "Department"
msgstr "വകുപ്പ്"

msgid "Not assigned yet"
msgstr "ഇതുവരെ ഏൽപ്പിച്ചിട്ടില്ല"

msgid "Urgency"
msgstr "അടിയന്തരത"

msgid "Edit"
msgstr "തിരുത്തുക"

msgid "Delete"
msgstr "ഇല്ലാതാക്കുക"

msgid "How CampusFix AI understood your complaint"
msgstr "CampusFix AI നിങ്ങളുടെ പരാതി എങ്ങനെ മനസ്സിലാക്കി"

msgid "Sent to"
msgstr "അയച്ചത്"

msgid "Problem type"
msgstr "പ്രശ്നത്തിന്റെ തരം"

msgid "Language detected"
msgstr "തിരിച്ചറിഞ്ഞ ഭാഷ"

msgid "Expected fix time"
msgstr "പ്രതീക്ഷിക്കുന്ന പരിഹാര സമയം"

#, python-format
msgid "about %(days)s days"
msgstr "ഏകദേശം %(days)s ദിവസം"

msgid "Decided by"
msgstr "തീരുമാനിച്ചത്"

msgid "AI summary"
msgstr "AI സംഗ്രഹം"

#, python-format
msgid ""
"Another student already reported this problem (%(percent)s%% similar). Your "
"complaint was linked to it so it gets fixed faster."
msgstr ""
"മറ്റൊരു വിദ്യാർത്ഥി ഈ പ്രശ്നം ഇതിനകം റിപ്പോർട്ട് ചെയ്തിട്ടുണ്ട് "
"(%(percent)s%% സമാനം). വേഗത്തിൽ പരിഹരിക്കാൻ നിങ്ങളുടെ പരാതി അതുമായി "
"ബന്ധിപ്പിച്ചു."

#, python-format
msgid ""
"%(count)s other student(s) reported the same problem. They were linked to "
"this complaint."
msgstr ""
"മറ്റ് %(count)s വിദ്യാർത്ഥി(കൾ) ഇതേ പ്രശ്നം റിപ്പോർട്ട് ചെയ്തു. അവ ഈ "
"പരാതിയുമായി ബന്ധിപ്പിച്ചു."

msgid ""
"Our two AI models disagreed about the department, so a staff member will "
"double-check it."
msgstr ""
"ഞങ്ങളുടെ രണ്ട് AI മോഡലുകളും വകുപ്പിനെക്കുറിച്ച് വിയോജിച്ചു, അതിനാൽ ഒരു "
"ജീവനക്കാരൻ അത് വീണ്ടും പരിശോധിക്കും."

msgid "AI routing (staff view)"
msgstr "AI റൂട്ടിംഗ് (ജീവനക്കാരുടെ കാഴ്ച)"

msgid "LLM said"
msgstr "LLM പറഞ്ഞത്"

msgid "Classifier said"
msgstr "ക്ലാസിഫയർ പറഞ്ഞത്"

msgid "Duplicates merged"
msgstr "ലയിപ്പിച്ച ആവർത്തനങ്ങൾ"

msgid "The LLM and the classifier disagree. Please check the category."
msgstr "LLM-ഉം ക്ലാസിഫയറും വിയോജിക്കുന്നു. വിഭാഗം പരിശോധിക്കുക."

msgid "Update status"
msgstr "നില പുതുക്കുക"

msgid "Update"
msgstr "പുതുക്കുക"

msgid "How was the fix?"
msgstr "പരിഹാരം എങ്ങനെയുണ്ടായിരുന്നു?"

msgid "Send feedback"
msgstr "ഫീഡ്ബാക്ക് അയയ്ക്കുക"

msgid "Feedback"
msgstr "ഫീഡ്ബാക്ക്"

msgid "Status timeline"
msgstr "നിലയുടെ ചരിത്രം"

#, python-format
msgid "by %(name)s"
msgstr "%(name)s മുഖേന"

msgid "Edit complaint"
msgstr "പരാതി തിരുത്തുക"

msgid "Report a problem"
msgstr "ഒരു പ്രശ്നം റിപ്പോർട്ട് ചെയ്യുക"

#, python-format
msgid "Edit complaint #%(id)s"
msgstr "പരാതി #%(id)s തിരുത്തുക"

msgid ""
"Just describe the problem and where it is. CampusFix AI will find the right "
"department and how urgent it is."
msgstr ""
"പ്രശ്നവും അത് എവിടെയാണെന്നും മാത്രം വിവരിക്കുക. ശരിയായ വകുപ്പും അടിയന്തരതയും"
" CampusFix AI കണ്ടെത്തും."

msgid "Save changes"
msgstr "മാറ്റങ്ങൾ സേവ് ചെയ്യുക"

msgid "Submit complaint"
msgstr "പരാതി സമർപ്പിക്കുക"

msgid "My complaints"
msgstr "എന്റെ പരാതികൾ"

#, python-format
msgid "%(department)s complaints"
msgstr "%(department)s പരാതികൾ"

msgid "All complaints"
msgstr "എല്ലാ പരാതികളും"

msgid "+ New complaint"
msgstr "+ പുതിയ പരാതി"

msgid "All statuses"
msgstr "എല്ലാ നിലകളും"

msgid "Search title, description, location"
msgstr "തലക്കെട്ട്, വിവരണം, സ്ഥലം തിരയുക"

msgid "Filter"
msgstr "ഫിൽട്ടർ"

msgid "Previous"
msgstr "മുമ്പത്തേത്"

#, python-format
msgid "Page %(number)s of %(total)s"
msgstr "പേജ് %(number)s / %(total)s"

msgid "Next"
msgstr "അടുത്തത്"

#, python-format
msgid "Hello, %(name)s"
msgstr "നമസ്കാരം, %(name)s"

msgid ""
"Submit new complaints and track their status. Statuses refresh "
"automatically."
msgstr ""
"പുതിയ പരാതികൾ സമർപ്പിച്ച് അവയുടെ നില അറിയുക. നിലകൾ സ്വയം പുതുക്കപ്പെടും."

msgid "(no department yet, ask an admin)"
msgstr "(ഇതുവരെ വകുപ്പില്ല, അഡ്മിനോട് ചോദിക്കുക)"

#, python-format
msgid ""
"You are signed in as staff of %(department)s. You see and update your "
"department's complaints."
msgstr ""
"നിങ്ങൾ %(department)s ജീവനക്കാരനായി ലോഗിൻ ചെയ്തിരിക്കുന്നു. നിങ്ങളുടെ "
"വകുപ്പിന്റെ പരാതികൾ കാണാനും പുതുക്കാനും കഴിയും."

msgid "Open the officials' dashboard →"
msgstr "ഉദ്യോഗസ്ഥരുടെ ഡാഷ്ബോർഡ് തുറക്കുക →"

msgid "You are signed in as admin. You see every complaint."
msgstr "നിങ്ങൾ അഡ്മിനായി ലോഗിൻ ചെയ്തിരിക്കുന്നു. എല്ലാ പരാതികളും കാണാം."

msgid "Django admin"
msgstr "Django അഡ്മിൻ"

msgid "Total"
msgstr "ആകെ"

msgid "Latest complaints"
msgstr "പുതിയ പരാതികൾ"

msgid "See all →"
msgstr "എല്ലാം കാണുക →"

msgid "Home"
msgstr "ഹോം"

msgid "Report campus problems in your own language"
msgstr "ക്യാമ്പസ് പ്രശ്നങ്ങൾ നിങ്ങളുടെ സ്വന്തം ഭാഷയിൽ റിപ്പോർട്ട് ചെയ്യൂ"

msgid ""
"Hostel, mess, Wi-Fi, labs, transport and more. Write in English, Tamil, "
"Malayalam, or a mix. CampusFix sends your complaint to the right department."
msgstr ""
"ഹോസ്റ്റൽ, മെസ്സ്, Wi-Fi, ലാബുകൾ, ഗതാഗതം തുടങ്ങിയവ. ഇംഗ്ലീഷ്, തമിഴ്, മലയാളം "
"അല്ലെങ്കിൽ ഇടകലർത്തി എഴുതാം. CampusFix നിങ്ങളുടെ പരാതി ശരിയായ വകുപ്പിലേക്ക് "
"അയയ്ക്കും."

msgid "Create a student account"
msgstr "വിദ്യാർത്ഥി അക്കൗണ്ട് സൃഷ്ടിക്കുക"

msgid "1. Write it your way"
msgstr "1. നിങ്ങളുടെ രീതിയിൽ എഴുതൂ"

msgid ""
"English, தமிழ், മലയാളം, or Tanglish/Manglish. No need to choose a "
"department."
msgstr ""
"English, தமிழ், മലയാളം അല്ലെങ്കിൽ Tanglish/Manglish. വകുപ്പ് "
"തിരഞ്ഞെടുക്കേണ്ടതില്ല."

msgid "2. AI reads it"
msgstr "2. AI അത് വായിക്കുന്നു"

msgid ""
"CampusFix AI finds the department, how urgent it is and where it happened, "
"and estimates the fix time."
msgstr ""
"CampusFix AI വകുപ്പും അടിയന്തരതയും സംഭവിച്ച സ്ഥലവും കണ്ടെത്തി പരിഹാര സമയം "
"കണക്കാക്കുന്നു."

msgid "3. Track it live"
msgstr "3. തത്സമയം അറിയൂ"

msgid ""
"If others reported the same problem, the complaints are merged. Your status "
"updates automatically."
msgstr ""
"മറ്റുള്ളവരും ഇതേ പ്രശ്നം റിപ്പോർട്ട് ചെയ്താൽ പരാതികൾ ലയിപ്പിക്കും. നിങ്ങളുടെ"
" നില സ്വയം പുതുക്കപ്പെടും."

msgid "New student?"
msgstr "പുതിയ വിദ്യാർത്ഥിയാണോ?"

msgid "Create an account"
msgstr "അക്കൗണ്ട് സൃഷ്ടിക്കുക"

msgid "Student registration"
msgstr "വിദ്യാർത്ഥി രജിസ്ട്രേഷൻ"

msgid "Already have an account?"
msgstr "ഇതിനകം അക്കൗണ്ട് ഉണ്ടോ?"

msgid "Welcome to CampusFix! Your account is ready."
msgstr "CampusFix-ലേക്ക് സ്വാഗതം! നിങ്ങളുടെ അക്കൗണ്ട് തയ്യാറാണ്."
